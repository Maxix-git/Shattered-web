# Shattered SMP Website — environment
# Copy to .env.local (VPS) or set in the Vercel dashboard.

# URL the website's server uses to reach the API.
# On Vercel: https://your-api.onrender.com (or your VPS API URL).
# On a VPS: http://127.0.0.1:4000 if the API runs on the same machine.
API_INTERNAL_URL=

# Discord OAuth (Discord Developer Portal -> your app -> OAuth2):
DISCORD_CLIENT_ID=1561333002905063425
DISCORD_CLIENT_SECRET=VcFkR67PpD-shlXVab738mRlMytli4W1
# Must EXACTLY match a redirect URI registered in the Discord app:
#   Vercel:  https://your-site.vercel.app/api/auth/discord/callback
#   VPS:     https://your-domain.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=

# Signs the session cookie. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Public site info.
NEXT_PUBLIC_SITE_NAME=Shattered SMP
NEXT_PUBLIC_SITE_URL=

# ============================================================
# SHATTERED SMP WEBSITE — environment example
# On Vercel: do NOT use this file — set these in Project
# Settings -> Environment Variables instead. For local dev:
# rename to `.env` in the shattered-web folder.
# ============================================================

# --- required ---
# Where the API runs
SITE_API_URL=https://shattered-api.onrender.com

# Same value as SITE_API_KEY on the API (Render env tab)
SITE_API_KEY=d3785bf4abd57f548c0ef7ff0b4d98f4f2631ca6559e05c97b8747fa1db4624a

# Signs login cookies — openssl rand -hex 32
SESSION_SECRET=f292496c993c18be8c6a317777eac87fbeb33542894bed9cbb448bf0c4cad3f2

# From Discord portal -> your app:
#   OAuth2 -> Client ID
DISCORD_CLIENT_ID=1561333002905063425
#   OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=VcFkR67PpD-shlXVab738mRlMytli4W1
# Must exactly match a redirect URL added in the portal
DISCORD_CALLBACK_URL=https://shatteredverse.vercel.app/auth/callback

# Host the site is served from (no https://, no trailing slash)
PUBLIC_HOST=shatteredverse.vercel.app

# Owner Discord user IDs, comma-separated (crown badge + Owners + Server tab)
ADMIN_DISCORD_IDS=1445147566789365800,1384200544444481556,1356437836399640758

# --- optional ---
# Minecraft server IP/port — powers the live status badge
MC_HOST=144.31.46.9
MC_PORT=11362
